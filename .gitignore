# Sunset Bay v11 — ignore rules for the repository.
#
# Anything generated, local-only, or machine-specific stays out of git.
# The game itself (game/), its screenshots, and the entry-point sources
# are tracked; everything a tool or a run produces is not.

# ---- build and submission output -----------------------------------
/output
dist
build
out
*.tgz
*.zip

# ---- dependencies and package-manager state ------------------------
node_modules
.pnp
.pnp.*
.yarn/cache
.yarn/install-state.gz
package-lock.json
yarn.lock
pnpm-lock.yaml

# ---- logs, caches, and coverage ------------------------------------
*.log
*.tmp
*.temp
.cache
.parcel-cache
coverage
.nyc_output

# ---- operating-system and editor droppings -------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea
.vscode
*.code-workspace

# ---- environment and secrets ---------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---- test and QA scratch -------------------------------------------
/tmp-qa
qa-output
