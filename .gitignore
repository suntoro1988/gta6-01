# Cache & tooling
.cache/
*.tsbuildinfo
.eslintcache

# Sistem operasi
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor & IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# Log & file sementara
*.log
logs/

# Rahasia & kredensial (JANGAN di-commit)
