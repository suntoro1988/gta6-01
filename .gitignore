# Sunset Bay v12 — files git must never track.
#
# Rule of thumb: if a machine made it, or only one machine needs it,
# it stays out of the repository. The entry is source + screenshots.

# --- build output ---
/output/
/dist/
/build/

# --- dependencies & package managers ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/
.bun/

# --- scratch & temporary files ---
/tmp/
tmp/
*.tmp
*.temp
*.swp
*.swo
*~

# --- logs & crash reports ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS & editor clutter ---
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# --- environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key
